# 提交闸门脚本必须是 LF 换行。
# 原因：Git for Windows 在 core.autocrlf=true 时会把 .sh 转成 CRLF，
#      而 CRLF 的 shebang 会让 Git Bash 报 "bad interpreter"，钩子静默失效。
.githooks/* text eol=lf
*.sh text eol=lf

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
# Python 源码统一 CRLF（本项目在 Windows 上开发）
*.py text eol=crlf

# 数据与二进制：不做换行转换、不做文本 diff
*.7z binary
*.zip binary
*.rar binary
*.xlsx binary
*.xls binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.pdf binary
