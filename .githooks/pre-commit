#!/bin/sh
# ===========================================================================
# MyLedger 提交闸门 (pre-commit)
#
# 作用：在提交写入 Git 历史之前，拦住真实账单 / 密钥 / 凭据。
#      这是最后一道防线，专治「手滑 git add .」。
#
# 本文件必须保持 LF 换行、且不能带 BOM（见 .gitattributes），否则 Git 会拒绝执行。
# 安装：双击 scripts\setup.cmd，或跑 scripts\install-git-hooks.ps1
#
# 为什么 shebang 是 #!/bin/sh 而不是 #!/usr/bin/env bash：
#   Windows 上 PATH 里的 bash 往往是 WSL 转发器
#   (%LOCALAPPDATA%\Microsoft\WindowsApps\bash.exe)，env 会优先命中它，
#   钩子被 WSL 接管后直接失败，闸门形同虚设。
#   Git for Windows 会把 /bin/sh 可靠地映射到自带的 sh.exe（实为 Bash 5.x），
#   所以用 /bin/sh 最稳。下面还有一段守卫，处理 Linux 上 /bin/sh 实为 dash 的情况。
#
# 依赖：只用 shell 内置命令 + git。
#      刻意不用 head / grep / sed / cat —— Git for Windows 执行钩子时的 PATH
#      未必包含 Git 自带的 coreutils，外部命令会报 command not found，
#      导致闸门静默失效。正则匹配一律用 shell 内置的 [[ =~ ]]，不 fork 外部进程。
#
# 紧急绕过（三思，内容会永久写入历史）：
#   MYLEDGER_ALLOW_SENSITIVE=YES_I_AM_SURE git commit -m "..."
# ===========================================================================

# 本脚本用到 Bash 特性（[[ =~ ]]、read -d、进程替换）。
# Git for Windows 的 /bin/sh 就是 Bash，BASH_VERSION 有值，直接放行；
# Debian 系 Linux 的 /bin/sh 是 dash，这里换成 Bash 重跑，保证跨平台可用。
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -uo pipefail

BYPASS="${MYLEDGER_ALLOW_SENSITIVE:-}"
FOUND=0
HITS=0
REPORT=""

note() {
  REPORT="${REPORT}  [拦截] $1"$'\n'
  FOUND=1
  HITS=$((HITS + 1))
}

# --------------------------------------------------------------------------
# 绕过留痕（ML-003）
#
# 为什么要有这一步：绕过变量是唯一保留的紧急通道，但它原本**不留任何痕迹** ——
# 事后完全无法回答「绕过过几次、当时提交了什么」。一次绕过可能是应急，
# 次次绕过就是防线失效，而用户在两种情况下看到的东西是一样的。
#
# 所以绕过时写一条结构化日志，放在**不会被提交**的地方。
# 位置三级兜底：项目里的 .workbuddy/（gitignore 已覆盖）→ 用户目录 → .git。
# .git 一定能写（否则这次提交根本没法发生），保证至少有一处留下记录。
#
# 全程只用 shell 内置命令 + git：
#   时间戳用 Bash 内置的 printf %(...)T，不用外部 date；
#   mkdir 找不到命令时 if 会走假分支，不会中断钩子。
#   写日志失败也绝对不能挡住提交 —— 它是「记录」，不是「放行条件」。
# --------------------------------------------------------------------------
log_bypass() {
  _ts=$(printf '%(%Y-%m-%dT%H:%M:%S%z)T' -1 2>/dev/null)
  [ -z "$_ts" ] && _ts="unknown-time"

  _who=$(git config user.name 2>/dev/null) || _who="unknown"
  [ -z "$_who" ] && _who="unknown"
  _mail=$(git config user.email 2>/dev/null) || _mail="unknown"
  [ -z "$_mail" ] && _mail="unknown"
  _branch=$(git symbolic-ref --short HEAD 2>/dev/null) || _branch="unknown"
  [ -z "$_branch" ] && _branch="unknown"

  _log=""
  for _dir in ".workbuddy/audit" "${HOME:-}/.MyLedger/audit" ".git"; do
    if mkdir -p "$_dir" 2>/dev/null && [ -d "$_dir" ]; then
      _log="$_dir/gate-bypass.log"
      break
    fi
  done

  if [ -z "$_log" ]; then
    echo "  （没能写下绕过记录：三个位置都不可写。这次绕过没有留下痕迹。）"
    return 0
  fi

  {
    printf '%s\tbypass-commit\tbranch=%s\tuser=%s <%s>\thits=%d\n' \
           "$_ts" "$_branch" "$_who" "$_mail" "$HITS"
    printf '%s' "$REPORT"
  } >> "$_log" 2>/dev/null || true

  echo "已记录：$_log"
  echo "（这个文件不在 Git 仓库里，也不会被推送 —— 想留多久留多久。）"
}

is_exempt() {
  case "$1" in
    imports/.gitkeep | data/.gitkeep | fixtures/.gitkeep) return 0 ;;
    *) return 1 ;;
  esac
}

# 敏感内容正则（shell 内置匹配，不依赖 grep）
#
# RE_PRIVKEY 里把 PRIV 和 ATE 拆成两段拼接，不是笔误：
# 私钥标记是完整的英文单词，如果这里写成完整字面量，
# 本文件自身就会包含那段文字，闸门会把自己的源码判成私钥，
# 结果是任何人都提交不了任何东西。拆开后正则完全等价，
# 但源码里不再出现能被自身匹配到的字面量。
# 同理，上面这段说明里也刻意不复述那个标记词。
RE_PRIVKEY='-----BEGIN [A-Z ]*PRIV''ATE KEY-----|BEGIN PGP PRIV''ATE'
RE_APIKEY='AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|sk-[A-Za-z0-9]{20,}'
RE_IDCARD='(^|[^0-9])[1-9][0-9]{5}(19|20)[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx]([^0-9]|$)'
RE_BANKCARD='(^|[^0-9])[0-9]{16,19}([^0-9]|$)'
RE_PHONE='(^|[^0-9])1[3-9][0-9]{9}([^0-9]|$)'

MAX_SCAN=2000000

while IFS= read -r -d '' f; do
  is_exempt "$f" && continue

  # --- 1. 数据目录 ---
  case "$f" in
    imports/* | data/* | vault/* | secrets/* | credentials/* | exports/*)
      note "数据目录不得提交：$f"
      ;;
  esac

  # --- 2. 敏感扩展名 ---
  # fixtures/ 是例外：脱敏后的合成样例本来就要进仓库，否则解析器没法测。
  # 但内容扫描（第 5 步）对它照常生效——身份证号、银行卡号、手机号依然会被拦下。
  # 换句话说：fixtures/ 里的 csv/xlsx 允许提交，但里面不许有真东西。
  case "$f" in
    fixtures/*)
      : ;;
    *)
      case "${f##*.}" in
        csv | tsv | xls | xlsx | ods | mdb | db | sqlite | sqlite3 | sqlcipher | \
        7z | zip | rar | age | gpg | enc | key | pem | pfx | p12 | jks | log)
          note "敏感文件类型不得提交：$f"
          ;;
      esac
      ;;
  esac

  # --- 3. 环境变量文件（模板/示例文件除外）---
  case "$f" in
    *.example | *.sample | *.template) : ;;
    .env | */.env | .env.* | */.env.*)
      note "环境变量文件不得提交：$f"
      ;;
  esac

  # --- 4. 超大文件（账单/数据库误拖入仓库的典型信号）---
  size=$(git cat-file -s ":$f" 2>/dev/null)
  [ -z "$size" ] && size=0

  if [ "$size" -gt "$MAX_SCAN" ]; then
    note "文件过大（${size} 字节），疑似数据文件：$f"
    continue
  fi

  # --- 5. 内容特征扫描 ---
  #
  # 用 read -d '' 而不是 $(git cat-file ...)：
  #   二进制文件（xlsx / zip / db）里有 NUL 字节，命令替换会丢掉 NUL 并往
  #   stderr 打一行 "warning: ignored null byte in input"。这行警告每次提交
  #   都会出现，会训练人忽略钩子输出——比报错更糟。
  #   read 遇到 NUL 就停，变量里永远不会出现 NUL；文本文件没有 NUL，
  #   行为与原来完全一致。
  content=""
  IFS= read -r -d '' -n "$MAX_SCAN" content < <(git cat-file -p ":$f" 2>/dev/null) || true
  [ -z "$content" ] && continue

  if [[ $content =~ $RE_PRIVKEY ]]; then note "疑似私钥内容：$f"; fi
  if [[ $content =~ $RE_APIKEY ]]; then note "疑似云端 API 密钥：$f"; fi
  if [[ $content =~ $RE_IDCARD ]]; then note "疑似身份证号：$f"; fi
  if [[ $content =~ $RE_BANKCARD ]]; then note "疑似 16-19 位银行卡号：$f"; fi
  if [[ $content =~ $RE_PHONE ]]; then note "疑似手机号：$f"; fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "$FOUND" -ne 0 ]; then
  if [ "$BYPASS" = "YES_I_AM_SURE" ]; then
    echo ""
    echo "警告：已通过 MYLEDGER_ALLOW_SENSITIVE 绕过提交闸门。"
    echo "以下内容将永久写入 Git 历史，删除文件无法撤回："
    printf '%s' "$REPORT"
    echo ""
    echo "这次绕过会被记下来（审计用，不是为了追责，是为了以后能查）："
    log_bypass
    echo ""
    echo "继续提交。"
    exit 0
  fi

  echo ""
  echo "提交被拦截 —— 检测到疑似真实账单 / 密钥 / 凭据："
  printf '%s' "$REPORT"
  echo ""
  echo "怎么处理："
  echo "  1. 真实账单放仓库外（默认 %USERPROFILE%\\MyLedgerVault），永远不进仓库。"
  echo "  2. 要用真实数据做测试，先脱敏成假数据放进 fixtures/。"
  echo "  3. 确认是误报：git reset HEAD <文件> 先把文件移出暂存区。"
  echo "  4. 硬要提交（极不推荐）：MYLEDGER_ALLOW_SENSITIVE=YES_I_AM_SURE git commit ..."
  echo ""
  exit 1
fi

exit 0
